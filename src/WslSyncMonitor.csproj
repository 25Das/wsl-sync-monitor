<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>WslSyncMonitor</AssemblyName>
    <RootNamespace>WslSyncMonitor</RootNamespace>
    <Version>1.11.2</Version>
    <Product>WSL Sync Monitor</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- os testes de interface (tests.windows) acessam partes internas, como os construtores de menu -->
    <InternalsVisibleTo Include="WslSyncMonitor.WindowsTests" />
  </ItemGroup>
</Project>
