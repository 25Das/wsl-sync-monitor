<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- só para a automação de interface (System.Windows.Automation): achar os ícones da barra no Windows 11 -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>WslSyncMonitor</AssemblyName>
    <RootNamespace>WslSyncMonitor</RootNamespace>
    <Version>1.17.1</Version>
    <Product>WSL Sync Monitor</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- o UseWPF tira estes dois "using" automáticos (por conflitos de nomes com o WPF, que o app não usa) -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- os testes de interface (tests.windows) acessam partes internas, como os construtores de menu -->
    <InternalsVisibleTo Include="WslSyncMonitor.WindowsTests" />
  </ItemGroup>
</Project>
