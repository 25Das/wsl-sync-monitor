<Project Sdk="Microsoft.NET.Sdk">
  <!-- Testes do que não depende do Windows (roda no Linux, inclusive no CI). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- publica cada teste que falhar como anotação no GitHub (os logs do CI não são acessíveis de fora) -->
    <PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../src/SyncthingScripts.cs" Link="src/SyncthingScripts.cs" />
    <Compile Include="../src/Diagnostics.cs" Link="src/Diagnostics.cs" />
    <Compile Include="../src/CredentialRules.cs" Link="src/CredentialRules.cs" />
    <Compile Include="../src/PanelBehavior.cs" Link="src/PanelBehavior.cs" />
    <Compile Include="../src/UpdateInfo.cs" Link="src/UpdateInfo.cs" />
    <Compile Include="../src/WslCommandLine.cs" Link="src/WslCommandLine.cs" />
    <Compile Include="../src/IconLayout.cs" Link="src/IconLayout.cs" />
    <Compile Include="../src/Models.cs" Link="src/Models.cs" />
    <Compile Include="../src/GuardRules.cs" Link="src/GuardRules.cs" />
    <Compile Include="../src/TrayIconModel.cs" Link="src/TrayIconModel.cs" />
    <Compile Include="../src/PanelFooter.cs" Link="src/PanelFooter.cs" />
    <Compile Include="../src/WslPaths.cs" Link="src/WslPaths.cs" />
    <Compile Include="../src/SyncthingParsers.cs" Link="src/SyncthingParsers.cs" />
    <Compile Include="../src/DiskSpace.cs" Link="src/DiskSpace.cs" />
    <Compile Include="../src/InstallPaths.cs" Link="src/InstallPaths.cs" />
    <Compile Include="../src/InstallDecision.cs" Link="src/InstallDecision.cs" />
    <Compile Include="../src/PanelHeader.cs" Link="src/PanelHeader.cs" />
    <Compile Include="../src/LogRules.cs" Link="src/LogRules.cs" />
    <Compile Include="../src/SyncthingApi.cs" Link="src/SyncthingApi.cs" />
    <Compile Include="../src/HealthCheck.cs" Link="src/HealthCheck.cs" />
    <Compile Include="../src/WidgetPlacement.cs" Link="src/WidgetPlacement.cs" />
    <Compile Include="../src/SyncthingActivity.cs" Link="src/SyncthingActivity.cs" />
    <Compile Include="../src/SyncthingEvents.cs" Link="src/SyncthingEvents.cs" />
    <Compile Include="../src/FileChangeWatcher.cs" Link="src/FileChangeWatcher.cs" />
    <Compile Include="../src/SyncthingHttp.cs" Link="src/SyncthingHttp.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
